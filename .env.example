# Noxfort Monitor™ - Configurações de Acesso Administrativo
#
# Para testes rápidos via GitHub:
# Se este arquivo não for copiado para .env, o sistema adota automaticamente:
# Usuário: admin
# Senha:   admin
#
# Para ambiente de Produção:
# Copie este arquivo para .env e defina credenciais fortes:
# cp .env.example .env
#
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=admin
